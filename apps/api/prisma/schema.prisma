// PHRAMA schema — one module block per build step (module plan docs/MODULE-PLAN.md)
// M1: users/audit. M2: catalog. M3: stock ledger. Money = integer paisa, never float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── M1 seed: users + audit. Catalog/inventory/ledger tables arrive with their modules. ──

enum Role {
  ADMIN
  ACCOUNTANT
  WAREHOUSE
  BOOKER
  SALESMAN
  COUNTER
}

model User {
  id           String          @id @default(cuid())
  username     String          @unique
  passwordHash String
  fullName     String
  role         Role
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  auditLogs    AuditLog[]
  stockDocs    StockDocument[]
  vouchers     Voucher[]
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ── M2: catalog master data ──

enum TaxPolicy {
  ABSORB
  STRICT
}

model Company {
  id          String             @id @default(cuid())
  code        String             @unique // short code, e.g. GSK
  name        String
  taxPolicies TaxPolicyHistory[]
  products    Product[]
  suppliers   Supplier[]
  createdAt   DateTime           @default(now())
}

// One row per policy decision, dated. Policies change; history never rewritten.
model TaxPolicyHistory {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  policy        TaxPolicy
  effectiveFrom DateTime
  createdAt     DateTime  @default(now())

  @@index([companyId, effectiveFrom])
}

// Date-effective GST rate table (FILER 0.5% / NON-FILER 2.5% today; gov can change).
model TaxRate {
  id            String              @id @default(cuid())
  kind          CustomerFilerStatus
  ratePct       Decimal             @db.Decimal(5, 4)
  effectiveFrom DateTime
  createdAt     DateTime            @default(now())

  @@index([kind, effectiveFrom])
}

model Product {
  id                String              @id @default(cuid())
  code              String              @unique // SAME ID as old pad/ERP (FR-1)
  name              String
  companyId         String
  company           Company             @relation(fields: [companyId], references: [id])
  pack              String?
  salePricePaisa    Int // rupees *100 (paisa) — exact integer math, no float
  taxAbsorbOverride Boolean? // null = follow company policy
  attributes        Json? // odd fields from old system
  active            Boolean             @default(true)
  batches           Batch[]
  stockMovements    StockMovement[]
  poItems           PurchaseOrderItem[]
  receiptItems      StockReceiptItem[]
  createdAt         DateTime            @default(now())
}

model Batch {
  id             String             @id @default(cuid())
  productId      String
  product        Product            @relation(fields: [productId], references: [id])
  batchNo        String
  mfgDate        DateTime?
  expiry         DateTime
  costPricePaisa Int
  stockMovements StockMovement[]
  receiptItems   StockReceiptItem[]
  createdAt      DateTime           @default(now())

  @@unique([productId, batchNo])
  @@index([expiry])
}

enum CustomerType {
  REGULAR
  SALESMAN
  PREPAID
}

enum CustomerFilerStatus {
  FILER
  NON_FILER
}

model Customer {
  id                  String              @id @default(cuid())
  code                String              @unique
  name                String
  type                CustomerType        @default(REGULAR)
  filerStatus         CustomerFilerStatus @default(NON_FILER)
  creditLimitPaisa    Int                 @default(0) // 0 = no limit; v1 display-only (no blocking), PREPAID gated at order time
  territoryId         String?
  territory           Territory?          @relation(fields: [territoryId], references: [id])
  salesmanId          String? // linked salesman for "on behalf of" routing
  salesman            Customer?           @relation("SalesmanCustomers", fields: [salesmanId], references: [id])
  salesmanCustomers   Customer[]          @relation("SalesmanCustomers")
  journalLines        JournalLine[]
  openingBalancePaisa Int                 @default(0)
  active              Boolean             @default(true)
  createdAt           DateTime            @default(now())
}

model Supplier {
  id                  String          @id @default(cuid())
  companyId           String
  company             Company         @relation(fields: [companyId], references: [id]) // suppliers = manufacturers/distributors we buy from
  openingBalancePaisa Int             @default(0) // positive = we owe them
  journalLines        JournalLine[]
  active              Boolean         @default(true)
  createdAt           DateTime        @default(now())
  purchaseOrders      PurchaseOrder[]
  stockReceipts       StockReceipt[]
}

model Territory {
  id          String     @id @default(cuid())
  name        String     @unique
  orderDay    Int? // 0=Sun..6=Sat — weekly area calendar (M10)
  deliveryDay Int?
  customers   Customer[]
  createdAt   DateTime   @default(now())
}

model Warehouse {
  id             String          @id @default(cuid())
  name           String          @unique
  kind           WarehouseKind   @default(MAIN)
  stockMovements StockMovement[]
  stockReceipts  StockReceipt[]
  createdAt      DateTime        @default(now())
}

enum WarehouseKind {
  MAIN
  VAN
  QUARANTINE
}

// ── M3: stock ledger — append-only movements; current stock = SUM(delta) ──

enum StockDocKind {
  OPENING
  TRANSFER
  ADJUSTMENT
  RECEIPT
}

enum StockMoveKind {
  OPENING
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  RECEIPT
}

model StockDocument {
  id        String          @id @default(cuid())
  kind      StockDocKind
  reason    String? // mandatory for ADJUSTMENT
  userId    String?
  user      User?           @relation(fields: [userId], references: [id])
  createdAt DateTime        @default(now())
  movements StockMovement[]
  receiptId Int?            @unique
  receipt   StockReceipt?

  @@index([createdAt])
}

model StockMovement {
  id          String        @id @default(cuid())
  docId       String
  doc         StockDocument @relation(fields: [docId], references: [id])
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  batchId     String
  batch       Batch         @relation(fields: [batchId], references: [id])
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  kind        StockMoveKind
  delta       Int // signed: +IN / -OUT; stock = SUM(delta)
  createdAt   DateTime      @default(now())

  @@index([productId, batchId, warehouseId])
  @@index([docId])
}

// M4: money ledger. A voucher IS the double-entry journal header (1:1);
// its JournalLines must balance (Dr sum = Cr sum, enforced in service + e2e).
// Balances are always computed from history (same rule as stock).

enum Account {
  CASH
  BANK
  AR // receivable: customer owes us (line tagged customerId)
  AP // payable: we owe supplier (line tagged supplierId)
  SALES
  SALES_RETURN
  TAX_CHARGED // GST charged to stores (strict companies) - M7 posts here
  TAX_ABSORBED // GST absorbed for stores, recoverable from companies - M7/M8
  INVENTORY
  EXPENSE
  OPENING_EQUITY
}

enum VoucherKind {
  CASH_RECEIPT
  BANK_RECEIPT
  CASH_PAYMENT
  BANK_PAYMENT
  EXPENSE
  JOURNAL
}

model Voucher {
  id        Int           @id @default(autoincrement())
  kind      VoucherKind
  date      DateTime      @default(now())
  memo      String?
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  lines     JournalLine[]
  createdAt DateTime      @default(now())

  @@index([date])
  @@index([kind])
}

model JournalLine {
  id          Int       @id @default(autoincrement())
  voucherId   Int
  voucher     Voucher   @relation(fields: [voucherId], references: [id])
  account     Account
  debitPaisa  Int       @default(0)
  creditPaisa Int       @default(0)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  memo        String?

  @@index([account, customerId])
  @@index([account, supplierId])
}

// M6: procurement. PO = operational doc (status may advance);
// receipts are immutable documents posting stock + payable in ONE transaction.

enum PurchaseOrderStatus {
  PENDING
  PARTIAL
  RECEIVED
}

model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  status       PurchaseOrderStatus @default(PENDING)
  date         DateTime            @default(now())
  expectedDate DateTime?
  memo         String?
  userId       String
  items        PurchaseOrderItem[]
  receipts     StockReceipt[]
  createdAt    DateTime            @default(now())

  @@index([status])
}

model PurchaseOrderItem {
  id            Int           @id @default(autoincrement())
  poId          Int
  po            PurchaseOrder @relation(fields: [poId], references: [id])
  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  orderedQty    Int
  unitCostPaisa Int

  @@unique([poId, productId])
}

model StockReceipt {
  id          Int                @id @default(autoincrement())
  poId        Int
  po          PurchaseOrder      @relation(fields: [poId], references: [id])
  supplierId  String
  supplier    Supplier           @relation(fields: [supplierId], references: [id])
  warehouseId String
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id])
  userId      String
  memo        String?
  stockDocId  String?            @unique
  stockDoc    StockDocument?     @relation(fields: [stockDocId], references: [id])
  date        DateTime           @default(now())
  items       StockReceiptItem[]
  createdAt   DateTime           @default(now())

  @@index([poId])
}

model StockReceiptItem {
  id            Int          @id @default(autoincrement())
  receiptId     Int
  receipt       StockReceipt @relation(fields: [receiptId], references: [id])
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  batchId       String
  batch         Batch        @relation(fields: [batchId], references: [id])
  receivedQty   Int
  unitCostPaisa Int
}
