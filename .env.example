# Local dev values — copy to apps/api/.env. NEVER commit real secrets.
DATABASE_URL=postgres://phrama:phrama@localhost:5432/phrama
REDIS_URL=redis://localhost:6379
PORT=4000
JWT_SECRET=dev-change-me-never-commit-real

# Production settings (used by docker compose + api)
NODE_ENV=development
ORIGIN=http://localhost:5173
POSTGRES_USER=phrama
POSTGRES_PASSWORD=phrama
POSTGRES_DB=phrama
